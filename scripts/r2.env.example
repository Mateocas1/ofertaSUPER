# Copy to ~/.config/ofertasuper/r2.env and chmod 600. Never commit real values.
# Raw R2 remote (rclone env-var config, remote name "r2").
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
RCLONE_CONFIG_R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
# Crypt remote (remote name "crypt") layered on the bucket. Both passwords must
# be OBSCURED: run `rclone obscure '<plain password>'` and paste the output.
RCLONE_CONFIG_CRYPT_TYPE=crypt
RCLONE_CONFIG_CRYPT_REMOTE=r2:ofertasuper-backups
RCLONE_CONFIG_CRYPT_PASSWORD=<OBSCURED_PASSWORD>
RCLONE_CONFIG_CRYPT_PASSWORD2=<OBSCURED_SALT_PASSWORD>
# Remote the cron uploads to, and how many days of dumps to keep.
R2_REMOTE=crypt
R2_RETENTION_DAYS=7
